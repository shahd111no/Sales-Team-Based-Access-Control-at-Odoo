<odoo>

    <record id="sale_team_category" model="ir.module.category">
        <field name="name">sale team category</field>
    </record>

    <record id="sale_first_team" model="res.groups">
        <field name="name">sale first team</field>
        <field name="implied_ids"
           eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="category_id" ref="sale_order_team.sale_team_category"/>
    </record>

    <record id="sale_order_team_rule" model="ir.rule">
        <field name="name">sale order team rule</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="domain_force">
        ['|',
        ('user_id', '=', user.id),
        ('team_id.member_ids', 'in', [user.id])
        ]
        </field>

        <field name="groups" eval="[(4, ref('sale_order_team.sale_first_team'))]"/>
    </record>



</odoo>